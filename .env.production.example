POLICY_SIGNAL_CLASSIFIER_BACKEND=fine-tuned
POLICY_SIGNAL_CLASSIFIER_MODEL=/models/policy-signal-baseline-v2-large
POLICY_SIGNAL_SPEAKER_ROLE_BACKEND=press-conference-text
POLICY_SIGNAL_SPEAKER_DIARIZATION_MODEL=/models/pyannote-speaker-diarization-community-1
POLICY_SIGNAL_SPEAKER_DIARIZATION_DEVICE=auto
POLICY_SIGNAL_SPEAKER_OPENING_ANCHOR_SECONDS=600
POLICY_SIGNAL_RELEVANCE_BACKEND=fine-tuned
POLICY_SIGNAL_RELEVANCE_MODEL=/models/policy-relevance-gate-v1
POLICY_SIGNAL_WHISPER_MODEL=/models/whisper-small.en
POLICY_SIGNAL_WHISPER_DEVICE=cpu
POLICY_SIGNAL_WHISPER_COMPUTE_TYPE=int8
POLICY_SIGNAL_DEFAULT_ASSET_CONTEXT=US equities
POLICY_SIGNAL_LOCAL_MODELS_ONLY=true
POLICY_SIGNAL_WARM_MODELS_ON_STARTUP=true
POLICY_SIGNAL_MAX_UPLOAD_MB=500
POLICY_SIGNAL_MAX_DURATION_SECONDS=7200
POLICY_SIGNAL_NEUTRAL_MARGIN=0.12
# Real use: only act when surprise vs priced consensus is measured.
POLICY_SIGNAL_REQUIRE_CONSENSUS_FOR_ACTION=true
POLICY_SIGNAL_MIN_SURPRISE=0.15
POLICY_SIGNAL_IMPACT_HORIZON_SECONDS=300
# Uncomment with a positive number to enable recency weighting for complete recordings.
# POLICY_SIGNAL_OFFLINE_RECENCY_HALF_LIFE_SECONDS=900
# Rolling stream signal only.
POLICY_SIGNAL_RECENCY_HALF_LIFE_SECONDS=90
POLICY_SIGNAL_STREAM_WINDOW_SECONDS=8
